# Shared Agent layer: the Pi bridge remains the entrypoint, while benchmark
# manifests pin the already-built image by its immutable repository digest.
ARG BASE_IMAGE=rd-bot/pi-agent:local
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="rd-bot coding benchmark agent runtime" \
      org.opencontainers.image.description="Offline benchmark agent layer; dependencies are inherited from the pinned local Pi base"

ENV PIP_NO_INDEX=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    npm_config_offline=true \
    YARN_ENABLE_NETWORK=0 \
    RD_EVAL_OFFLINE=1
