# =============================================================================
# Dockerfile.relay — RD-Bot Evaluation V2 One-Shot HTTP Relay (linux/amd64)
# =============================================================================
# Evaluation V2 Step 1a template.
#
# PURPOSE (spec §7.3)
# -------------------
# This relay sits in the Docker network topology between the benchmark
# agent container and the upstream LLM API.  It is NOT a general proxy — it
# implements a strict, frozen contract:
#
#   1. Reads a frozen profile (fixed model + upstream URL + allowed paths)
#      from /etc/relay/profile.json at startup.
#   2. Requires a one-shot relay token via Authorization: Bearer header.
#      The token is written to RD_RELAY_TOKEN_FILE at container start by
#      the host orchestrator and immediately cleared from process memory.
#   3. Only forwards requests whose path appears in allowed_paths (exact match).
#   4. Only accepts the POST method.
#   5. NEVER exposes the upstream API key to the agent container.
#      RD_RELAY_UPSTREAM_API_KEY is set by the host BEFORE container start;
#      it lives only in the relay's own environment, never in image layers.
#   6. Logs ONLY status code, model, and path — never request/response bodies
#      (spec §13: no exposure of full prompts, raw Pi events, or keys).
#
# NETWORK TOPOLOGY
# ----------------
#   agent container ──(internal docker network)──► relay container
#                                                     │
#                                                     └──(external network,
#                                                          host-managed credentials)
#                                                          ► upstream LLM API
#
# BUILD & RUN
# -----------
# Obtain digest:
#   curl -sL "https://index.docker.io/v2/library/python/manifests/3.12-slim-bookworm" \
#     -H "Accept: application/vnd.docker.distribution.manifest.v2+json" \
#   | jq -r '.config.digest'
#
#   docker build \
#       --build-arg "BASE_IMAGE_DIGEST=sha256:<from_above>" \
#       -t rd-bot/coding-eval-relay:20260730-amd64-v1 \
#       -f Dockerfile.relay .
#
# Host-side orchestration (example):
#   # Write one-shot token to a temp file (host-side; never baked into image)
#   RD_TOKEN=$(openssl rand -hex 32)
#   echo "$RD_TOKEN" > /tmp/relay_token_$CASE_ID
#
#   docker run --rm \
#       -v /tmp/relay_token_$CASE_ID:/run/secrets/rd_relay_token:ro \
#       -e RD_RELAY_TOKEN_FILE=/run/secrets/rd_relay_token \
#       -e RD_RELAY_TOKEN="$(cat /tmp/relay_token_$CASE_ID)" \
#       -e RD_RELAY_PROFILE_PATH=/etc/relay/profile.json \
#       -e RD_RELAY_UPSTREAM_API_KEY="${UPSTREAM_API_KEY}" \
#       --network rd-benchmark-internal \
#       rd-bot/coding-eval-relay:20260730-amd64-v1
#
# PROFILE SCHEMA (written by host, mounted at /etc/relay/profile.json):
#   {
#     "model": "gpt-4o",
#     "upstream_url": "https://api.openai.com/v1",
#     "allowed_paths": ["/v1/chat/completions", "/v1/models"]
#   }
# =============================================================================

ARG BASE_IMAGE=python:3.12-slim-bookworm
FROM ${BASE_IMAGE}

# Local probe builds may use the floating bookworm tag above. Formal amd64 freezes should
# pass `--build-arg BASE_IMAGE=python:3.12-slim-bookworm@sha256:<digest>` instead.

# ── build arguments ───────────────────────────────────────────────────────────
ARG RELAY_LAYER_SHA256="REPLACE_WITH_ACTUAL_LAYER_SHA256_AFTER_BUILD"

# ── system packages ───────────────────────────────────────────────────────────
# All runtime deps are Python packages (see requirements.txt).  No apt
# packages are needed beyond the base image.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && apt-get clean

# ── Python dependencies ────────────────────────────────────────────────────────
# gunicorn: production-grade ASGI/WSGI server for the aiohttp app.
# aiohttp:  async HTTP server/client with full control over request routing.
#           We deliberately avoid Flask to keep the attack surface minimal.
#           (Flask ships with a development server, template engine, and
#            session middleware that are not needed here and add surface.)
COPY relay/requirements.txt /tmp/relay_requirements.txt
RUN pip install --no-cache-dir -r /tmp/relay_requirements.txt \
 && rm /tmp/relay_requirements.txt

# ── relay application ─────────────────────────────────────────────────────────
# relay.py implements the one-shot relay contract described in PURPOSE above.
# It is a standalone file so it can be unit-tested independently of Docker.
COPY relay/relay_compat.py /app/relay_compat.py
COPY relay/relay.py /app/relay.py

# ── frozen profile mount point ────────────────────────────────────────────────
# Host writes the frozen profile JSON before container start.
# Directory is owned by the relay user; file must be readable.
RUN mkdir -p /etc/relay \
 && chmod 755 /etc/relay

# ── non-root runtime user ────────────────────────────────────────────────────
# The relay runs as an unprivileged user.  Port 8765 is a high port so
# binding does not require root; the relay user has no shell.
RUN groupadd --gid 1001 relay \
 && useradd --uid 1001 --gid relay --shell /usr/sbin/nologin --no-create-home relay

# App directory and config dir must be readable.
RUN mkdir -p /app \
 && chown -R relay:relay /app /etc/relay

USER relay

WORKDIR /app

# ── environment contract ──────────────────────────────────────────────────────
# These env vars must be set by the host orchestrator before container start.
# They are NOT baked into image layers.
#
#   RD_RELAY_TOKEN         — Bearer token for this trial's one-shot auth
#   RD_RELAY_TOKEN_FILE    — Path to the token file (used to clear the file)
#   RD_RELAY_PROFILE_PATH — Path to frozen profile JSON (default /etc/relay/profile.json)
#   RD_RELAY_UPSTREAM_API_KEY — Upstream API key; set by host, never in layers
#
ENV RD_RELAY_PROFILE_PATH=/etc/relay/profile.json
ENV RD_RELAY_UPSTREAM_API_KEY=""

# ── health endpoint ──────────────────────────────────────────────────────────
# GET /health returns 200 with no body — useful for readiness probes.
# All other paths require valid Bearer token and are subject to the profile
# whitelist.

EXPOSE 8765

# ── startup: clear one-shot token from env immediately after reading ───────────
# The relay.py entrypoint receives the token via env, reads it into memory,
# then calls clearenv() to strip it from the process environment block so
# it is not visible in /proc/<pid>/environ of the running container.
# The token file (if RD_RELAY_TOKEN_FILE is set) is removed at the same time.
ENTRYPOINT ["python3", "/app/relay.py"]

# ── OCI labels ────────────────────────────────────────────────────────────────
LABEL org.opencontainers.image.title="rd-bot/coding-eval-relay" \
      org.opencontainers.image.description="RD-Bot Evaluation V2 one-shot HTTP relay (linux/amd64)" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/wish233/rd-bot" \
      org.opencontainers.image.platform="linux/amd64" \
      rd.evaluation.kind="coding-benchmark-relay" \
      rd.evaluation.role="relay" \
      rd.evaluation.platform="linux/amd64" \
      rd.evaluation.build-relay-layer-sha256="${RELAY_LAYER_SHA256}"
