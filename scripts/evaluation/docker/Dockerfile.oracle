# Reference definition for registry builds. Locally, the build helper derives a
# content-addressed thin layer from the same pinned base without BuildKit. The
# runtime executor clears the inherited Pi bridge with `--entrypoint ""`, then
# supplies the frozen verifier argv directly.
ARG BASE_IMAGE=rd-bot/pi-agent:local
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="rd-bot coding benchmark oracle runtime" \
      org.opencontainers.image.description="Offline Oracle layer; no agent worktree or cache is ever mounted"

ENV PIP_NO_INDEX=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    npm_config_offline=true \
    YARN_ENABLE_NETWORK=0 \
    RD_EVAL_OFFLINE=1
