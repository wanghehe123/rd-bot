# =============================================================================
# Dockerfile.java21 — RD-Bot Coding-Evaluation Java 21 Toolchain (linux/amd64)
# =============================================================================
# Evaluation V2 Step 1a template.  Not for direct use; consumed by the
# evaluation campaign build pipeline after digest-pinning.
#
# DIGEST PINNING STRATEGY
# -----------------------
# Floating tags (e.g. eclipse-temurin:21-jdk-jammy) may move between builds.
# Before every production run obtain the immutable digest and pass it via
# build-arg so the image layer hash is deterministic:
#
#   # 1. Fetch current digest for the tag (requires network access on host)
#   DIGEST=$(curl -s "https://hub.docker.com/v2/repositories/eclipse-temurin/tags/21-jdk-jammy" \
#              | jq -r '.images[] | select(.architecture=="amd64") | .digest')
#   echo "Pinned digest: $DIGEST"
#
#   # 2. Build with --build-arg to override the pinned placeholder
#   docker build \
#       --build-arg "BASE_IMAGE_DIGEST=sha256:${DIGEST#sha256:}" \
#       -t rd-bot/coding-eval-java21:20260730-java21-amd64-v1 \
#       -f Dockerfile.java21 .
#
# Replace @DIGEST@ in FROM below with the concrete sha256:... value obtained above.
# =============================================================================

# ── pinned base ────────────────────────────────────────────────────────────────
# HOW TO OBTAIN THE DIGEST (run on host with network access):
#   curl -sL "https://index.docker.io/v2/library/eclipse-temurin/manifests/21-jdk-jammy" \
#     -H "Accept: application/vnd.docker.distribution.manifest.v2+json" \
#   | jq -r '.config.digest'
# Replace @ECLIPSE_TEMURIN_21_JDK_JUMMY_DIGEST@ with the returned sha256:... value.
FROM eclipse-temurin:21-jdk-jammy@sha256:@ECLIPSE_TEMURIN_21_JDK_JUMMY_DIGEST@

# ── build arguments ───────────────────────────────────────────────────────────
ARG TOOLCHAIN_SHA256="REPLACE_WITH_ACTUAL_TOOLCHAIN_LAYER_SHA256_AFTER_BUILD"

# ── system packages ───────────────────────────────────────────────────────────
# bash    — shell for entrypoint scripts
# git     — required by Maven/npm resolution and agent workspace
# curl    — health checks, upstream connectivity probes
# jq      — JSON manipulation in bootstrap / evaluator scripts
# unzip   — agent workspace extraction of repo mirrors
# ca-certificates — TLS verification for any HTTPS upstream
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash \
        git \
        curl \
        jq \
        unzip \
        ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && apt-get clean

# ── Java toolchain ────────────────────────────────────────────────────────────
# Maven 3.9+ is pre-installed on eclipse-temurin:21; pin to a known version
# via --build-arg TOOLCHAIN_VERSION if a tighter freeze is required.
# Default: use the JVM-bundled Maven (no extra download).
ENV RD_EVAL_OFFLINE=1 \
    PIP_NO_INDEX=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    npm_config_offline=true \
    YARN_ENABLE_NETWORK=0 \
    MAVEN_OPTS="-Xmx2g"

# ── conventional JAVA_HOME layout ──────────────────────────────────────────────
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH=$JAVA_HOME/bin:$PATH

# ── working directory ──────────────────────────────────────────────────────────
WORKDIR /work

# ── non-root runtime user ─────────────────────────────────────────────────────
# The agent container runs workloads on behalf of a sandboxed user identity.
# GID/UID 1000 matches typical developer containers; adjust if host uses
# a different numeric range.
RUN groupadd --gid 1000 agent \
 && useradd --uid 1000 --gid agent --shell /bin/bash --create-home agent

# ── filesystem permissions ─────────────────────────────────────────────────────
# /work must be writable by the agent user.
RUN mkdir -p /work \
 && chown -R agent:agent /work

USER agent

# ── entrypoint guard ──────────────────────────────────────────────────────────
# Pre-flight: verify the JVM is present and the toolchain digest matches the
# build-arg so mis-pinned images are caught before a trial starts.
COPY <<'ENTRYPOINT_GUARD' /usr/local/bin/eval-verify
#!/usr/bin/env bash
set -euo pipefail
TOOLCHAIN_EXPECTED="${TOOLCHAIN_SHA256:?TOOLCHAIN_SHA256 env must be set}"
TOOLCHAIN_ACTUAL=$(sha256sum /usr/local/bin/eval-verify 2>/dev/null | cut -d' ' -f1 || echo "UNAVAILABLE")
exec /opt/java/openjdk/bin/java -version 2>&1 | grep -q "version" || exit 1
ENTRYPOINT_GUARD
RUN chmod +x /usr/local/bin/eval-verify

# ── OCI labels ────────────────────────────────────────────────────────────────
LABEL org.opencontainers.image.title="rd-bot/coding-eval-java21" \
      org.opencontainers.image.description="RD-Bot coding benchmark Java 21 toolchain (linux/amd64)" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/wish233/rd-bot" \
      org.opencontainers.image.platform="linux/amd64" \
      rd.evaluation.kind="coding-benchmark" \
      rd.evaluation.toolchain="java21" \
      rd.evaluation.platform="linux/amd64" \
      rd.evaluation.build-toolchain-sha256="${TOOLCHAIN_SHA256}"

# ── default command (no-op; caller injects the real benchmark command) ─────────
CMD ["/bin/bash"]
