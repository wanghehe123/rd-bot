# 简历数据实测——统一参数配置
# 用法：cp bench.env.example bench.env && 按需修改；所有脚本启动时 source bench.env
# bench.env 不入库（含本机路径），bench.env.example 入库作为参数契约。

# ---- RD-Bot 后端 ----
RD_BOT_BASE_URL="http://localhost:18080"
# 后端重启命令（E2 中断恢复实验用；按你的实际启动方式修改）
RD_BOT_RESTART_CMD="./mvnw -pl bootstrap spring-boot:run -Dspring-boot.run.profiles=longcat"
# 后端进程匹配关键字（kill -9 定位用）
RD_BOT_PROCESS_PATTERN="rd.bootstrap"

# ---- SWE-bench 配对测试 ----
RUN_ROOT="qa-runs/swebench-lite-10"
RUN_PLAN="qa-runs/swebench-lite-10/run-plan.json"
# 两组必须同模型、同预算、同 turns（红线 #3）
CLAUDE_MODEL_LABEL="claude-code-2.1.202"
MAX_BUDGET_USD="4"
MAX_TURNS="30"

# ---- 轮询与超时 ----
POLL_INTERVAL_SECONDS="30"
# 单题 RD-Bot 端到端硬超时（超过判 TIMEOUT，计入失败）
POLL_TIMEOUT_MINUTES="90"
# E2：后端重启后等待自动恢复的窗口（recovery-interval-millis=30s，给 4 个周期）
RECOVERY_WAIT_SECONDS="120"

# ---- 产物目录 ----
METRICS_DIR="qa-runs/benchmarks-metrics"
INTERRUPT_DIR="qa-runs/interrupt-recovery"
QA_DETECTION_DIR="qa-runs/qa-detection-rate"
