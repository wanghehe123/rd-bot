{
  "server": {
    "host": "0.0.0.0",
    "port": 1933,
    "auth_mode": "api_key",
    "root_api_key": "rd-bot-local-openviking-root",
    "cors_origins": []
  },
  "storage": {
    "workspace": "/app/.openviking/data",
    "agfs": { "backend": "local" },
    "vectordb": { "backend": "local" }
  },
  "embedding": {
    "dense": {
      "provider": "openai",
      "api_base": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "api_key": "${DASHSCOPE_API_KEY}",
      "model": "text-embedding-v4",
      "dimension": 1024,
      "input": "text"
    }
  },
  "vlm": {
    "provider": "openai",
    "api_base": "http://openviking-mock-llm:8080/v1",
    "api_key": "rd-bot-local-mock-vlm",
    "model": "rd-bot-mock-chat"
  }
}
