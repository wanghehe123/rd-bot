# RD-Bot Docker runtime configuration (template).
#
# Copy to deploy/docker/runtime.env — `./scripts/rd-bot.sh up` generates this file
# for you with random secrets (0600, never committed; *.env is gitignored).
# Values below are placeholders only: never commit real credentials.

# --- stack identity -------------------------------------------------------
# Fixed project name for the everyday stack; acceptance runs override it.
COMPOSE_PROJECT_NAME=rd-bot
# Image tag for app + Pi + QA, kept identical so the stack is self-consistent.
RD_BOT_IMAGE_TAG=oss-test
RD_BOT_APP_IMAGE=rd-bot/app

# --- host publishing ------------------------------------------------------
# Admin UI is published on loopback only.
RD_BOT_PORT=18080

# --- docker socket access -------------------------------------------------
# Numeric GID of the host group owning /var/run/docker.sock (launcher autodetects).
DOCKER_GID=999

# --- workspace ------------------------------------------------------------
# Absolute path shared between the backend container and Pi/QA agent containers.
RD_BOT_WORKSPACE_ROOT=/absolute/path/to/repo/.rd-bot-data/workspaces

# --- egress network -------------------------------------------------------
# Fixed name so relay sidecars can join; isolated acceptance stacks must override
# with a run-id-unique name.
RD_BOT_EGRESS_NETWORK=rd-bot-egress

# --- secrets (launcher generates; blank means fail closed where supported) --
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
RUSTFS_ACCESS_KEY_ID=
RUSTFS_SECRET_ACCESS_KEY=
RUSTFS_BUCKET=biz
# Runtime mutation token; if empty, runtime mutations are denied (fail closed).
RD_AGENT_RUNTIME_MUTATION_TOKEN=
# GitHub PAT used for clone/PR on repositories you authorize (repo scope).
# Leave empty until you want GitHub delivery; the stack starts fine without it.
GITHUB_PAT=

# --- agent container resources --------------------------------------------
# Cap MUST NOT exceed host CPU count (docker run rejects otherwise).
RD_EXECUTOR_PI_CPU_LIMIT=4
RD_EXECUTOR_PI_MEMORY_LIMIT=8g
