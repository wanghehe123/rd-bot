ARG PI_BASE_IMAGE=rd-bot/pi-agent:local
# Previous local QA image supplies Playwright browsers so Mac rebuilds are not
# blocked on flaky CDN downloads. First-time builds still need an existing cache
# tag, or `playwright install` downloads Chromium as before.
ARG BROWSER_CACHE_IMAGE=rd-bot/pi-agent-qa:local
FROM ${BROWSER_CACHE_IMAGE} AS browser-cache
FROM ${PI_BASE_IMAGE}

USER root

# Mirror override for restricted-network builds; versions stay pinned by the base image lockfile.
ARG NPM_REGISTRY=https://registry.npmjs.org
ARG PLAYWRIGHT_CLI_VERSION=0.1.17
# Optional Debian mirror override (e.g. http://mirrors.aliyun.com/debian) for
# restricted-network builds; default keeps the official mirror.
ARG DEBIAN_MIRROR=deb.debian.org
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_MCP_CONFIG=/etc/rd-bot/playwright-cli.config.json

COPY --from=browser-cache /ms-playwright /ms-playwright

# QA toolchain parity with the Claude QA image: browser validation via Playwright
# Chromium plus curl/zip for service health checks and evidence bundling.
# install-deps is still required on the slim Node base; playwright install is a
# version/checksum check when /ms-playwright already contains the pinned browsers.
# Apply DEBIAN_MIRROR before install-deps: Playwright apt-get otherwise hits
# deb.debian.org (~20 kB/s from this VM) and ignores the later mirror RUN.
RUN sed -i "s|deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources 2>/dev/null || true \
    && npm install -g "@playwright/cli@${PLAYWRIGHT_CLI_VERSION}" --registry=${NPM_REGISTRY} \
    && node /usr/local/lib/node_modules/@playwright/cli/node_modules/playwright/cli.js install-deps chromium \
    && for attempt in 1 2 3; do \
        PLAYWRIGHT_DOWNLOAD_CONNECTION_TIMEOUT=120000 \
          node /usr/local/lib/node_modules/@playwright/cli/node_modules/playwright/cli.js install chromium && break; \
        if [ "$attempt" -eq 3 ]; then \
          echo "Playwright Chromium download failed after ${attempt} attempts" >&2; \
          exit 1; \
        fi; \
        echo "Playwright Chromium download attempt ${attempt} failed; retrying" >&2; \
        sleep "$attempt"; \
      done \
    && npm cache clean --force \
    && chown -R node:node /ms-playwright /home/node

# build-essential keeps node-gyp fallbacks working for native modules
# (better-sqlite3 etc.) when prebuilt binary downloads fail; without it a
# flaky GitHub release download turns into an unrecoverable provision error.
RUN sed -i "s|deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources 2>/dev/null || true \
    && apt-get update \
    && apt-get install -y --no-install-recommends curl zip build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY rd-qa-evidence.mjs /usr/local/bin/rd-qa-evidence.mjs
COPY playwright-cli.config.json /etc/rd-bot/playwright-cli.config.json
RUN chmod 0755 /usr/local/bin/rd-qa-evidence.mjs \
    && chmod 0644 /etc/rd-bot/playwright-cli.config.json

USER node
ENTRYPOINT ["node", "/opt/rd-pi-bridge/src/rd-pi-bridge.mjs"]
