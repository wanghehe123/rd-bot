{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rd-agent-fact-v1.schema.json",
  "title": "RD role execution fact",
  "type": "object",
  "additionalProperties": false,
  "required": ["factId", "kind", "statement", "freshnessPolicy"],
  "properties": {
    "factId": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["DECLARED", "OBSERVED", "INFERRED", "HISTORICAL"]
    },
    "statement": { "type": "string", "minLength": 1, "maxLength": 512 },
    "sourceArtifactId": { "type": "string", "minLength": 1 },
    "sourceStageRunId": { "type": "string", "minLength": 1 },
    "sourceToolCallId": { "type": "string", "minLength": 1 },
    "repoRevision": { "type": "string", "minLength": 1 },
    "workspaceFingerprint": { "type": "string", "minLength": 1 },
    "observedAt": { "type": "string", "minLength": 1 },
    "commandHash": { "type": "string", "minLength": 1 },
    "freshnessPolicy": {
      "type": "string",
      "enum": ["SAME_REVISION", "SAME_WORKSPACE", "TTL", "ALWAYS_RECHECK"]
    },
    "expiresAt": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "freshnessStatus": {
      "type": "string",
      "enum": ["FRESH", "STALE"]
    }
  }
}
