{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rd-pi-request-v2.schema.json",
  "title": "RD Pi one-shot request v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "snapshotId",
    "stageRunId",
    "taskId",
    "role",
    "prompt",
    "provider",
    "model",
    "repoPath",
    "inputPath",
    "outputPath",
    "resourceManifestPath",
    "inputManifestPath",
    "inputManifestHash",
    "contextPolicy",
    "toolPolicy"
  ],
  "properties": {
    "protocol": { "const": "rd-pi-request/v2" },
    "snapshotId": { "type": "string", "minLength": 1 },
    "stageRunId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "role": {
      "type": "string",
      "enum": ["REQUIREMENT_REVIEWER", "SOLUTION_ARCHITECT", "CODING_AGENT", "QA_AGENT"]
    },
    "prompt": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "repoPath": { "type": "string", "const": "/work/repo" },
    "inputPath": { "type": "string", "const": "/work/input" },
    "outputPath": { "type": "string", "const": "/work/output" },
    "resourceManifestPath": { "type": "string", "const": "/work/input/resource-manifest.json" },
    "inputManifestPath": {
      "type": "string",
      "const": "/work/input/role-execution-input-manifest.json"
    },
    "inputManifestHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "contextPolicy": { "$ref": "rd-runtime-context-policy-v1.schema.json" },
    "api": { "type": "string", "minLength": 1 },
    "baseUrl": { "type": "string", "format": "uri" },
    "authHeader": { "type": "boolean" },
    "applyCandidatePatch": { "type": "boolean" },
    "patchArtifactPath": { "type": "string", "minLength": 1, "pattern": "^/work/output/" },
    "maxAgentTurns": { "type": "integer", "minimum": 1 },
    "maxTotalTokens": { "type": "integer", "minimum": 1 },
    "credentialEnvironmentVariable": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
    "toolPolicy": { "type": "object" },
    "extensionSet": { "type": "object" },
    "contextFiles": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object" },
    "dynamicStateEnabled": { "type": "boolean" },
    "maxInjectedStateBytes": { "type": "integer", "minimum": 1 },
    "attemptNo": { "type": "integer", "minimum": 1 },
    "contextProtocolVersion": { "type": "string" },
    "agentStateSchemaVersion": { "type": "string" },
    "toolRetryPolicyVersion": { "type": "string" }
  }
}
