{
  "$schema": "https://opencode.ai/config.json",

  "model": "opencode-go/kimi-k2.7-code",

  "agent": {
    "build": {
      "reasoningEffort": "max",
      "permission": {
        "task": {
          "*": "deny",
          "premium-advisor": "allow"
        },
        "skill": {
          "*": "allow",
          "model-escalation": "allow"
        }
      }
    },

    "premium-advisor": {
      "description": "High-capability read-only advisor for critical engineering decisions, root-cause analysis and final design review.",
      "mode": "subagent",
      "hidden": true,
      "model": "opencode-go/kimi-k3",
      "steps": 6,
      "prompt": "{file:./.opencode/prompts/premium-advisor.md}",
      "reasoningEffort": "max",

      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",

        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "skill": "deny",
        "question": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "deny"
      }
    }
  }
}
