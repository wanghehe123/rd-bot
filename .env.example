# RD-Bot local environment EXAMPLE (no real secrets).
# Copy to a gitignored file if you prefer env vars over application-local.yaml:
#   cp .env.example .env.local
# Then `set -a && source .env.local && set +a` (this repo gitignores *.env and *.local).

# --- docker-compose / Postgres (jdbc defaults align with application.yaml) ---
POSTGRES_URL=jdbc:postgresql://127.0.0.1:5432/rdbot?client_encoding=UTF8
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rdbot
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- S3-compatible object storage (MinIO in compose; app keys use RUSTFS_*) ---
RUSTFS_URL=http://localhost:9000
RUSTFS_BUCKET=biz
RUSTFS_ACCESS_KEY_ID=rustfsadmin
RUSTFS_SECRET_ACCESS_KEY=rustfsadmin

# --- Optional integrations (leave empty for mock / local smoke) ---
GITHUB_PAT=
OPENCODE_API_KEY=
DEEPSEEK_API_KEY=

# --- Pi agent images (only if you enable Docker agent runtime) ---
RD_EXECUTOR_PI_IMAGE=rd-bot/pi-agent:local
RD_EXECUTOR_PI_QA_IMAGE=rd-bot/pi-agent-qa:local

# --- Spring ---
# SPRING_PROFILES_ACTIVE=local
