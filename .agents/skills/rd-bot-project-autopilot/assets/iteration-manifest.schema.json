{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rd-bot-autopilot/manifest",
  "oneOf": [
    { "$ref": "#/$defs/v1" },
    { "$ref": "#/$defs/v2" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "string" },
        "runId": { "type": "string", "pattern": "^autopilot-[a-z0-9-]{1,80}$" },
        "mode": { "type": "string" },
        "projectId": { "type": "string", "maxLength": 64 },
        "idea": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "successCriteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "status": { "type": "string" },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxIterations", "maxActiveTasks", "maxRetriesPerTask", "maxElapsedMinutes", "maxTokenBudget"],
          "properties": {
            "maxIterations": { "type": "integer", "minimum": 1, "maximum": 2 },
            "maxActiveTasks": { "const": 1 },
            "maxRetriesPerTask": { "type": "integer", "minimum": 0, "maximum": 1 },
            "maxElapsedMinutes": { "type": "integer", "minimum": 1, "maximum": 120 },
            "maxTokenBudget": { "type": "integer", "minimum": 1, "maximum": 200000 }
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["iterations", "tasksCreated", "retries", "elapsedMinutes", "observedTokens"],
          "properties": {
            "iterations": { "type": "integer", "minimum": 0, "maximum": 2 },
            "tasksCreated": { "type": "integer", "minimum": 0, "maximum": 2 },
            "retries": { "type": "integer", "minimum": 0, "maximum": 2 },
            "elapsedMinutes": { "type": "integer", "minimum": 0, "maximum": 120 },
            "observedTokens": { "type": "integer", "minimum": 0, "maximum": 200000 },
            "budgetExceeded": { "type": "boolean" }
          }
        },
        "iterations": { "type": "array", "maxItems": 2, "items": { "type": "object" } },
        "pendingApproval": { "type": ["object", "null"] },
        "stopReason": { "type": "string", "maxLength": 1000 },
        "lastTransitionReason": { "type": "string", "maxLength": 1000 },
        "workspaceBefore": { "type": ["object", "null"] },
        "workspaceAfter": { "type": ["object", "null"] },
        "workspaceVerified": { "type": "boolean" },
        "requestLedger": { "type": "array", "maxItems": 500, "items": { "type": "object" } },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": [
        "schemaVersion", "runId", "mode", "projectId", "idea", "successCriteria", "status",
        "limits", "usage", "iterations", "pendingApproval", "stopReason", "lastTransitionReason",
        "workspaceBefore", "workspaceAfter", "workspaceVerified", "requestLedger", "createdAt", "updatedAt"
      ]
    },
    "v1": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "schemaVersion": { "const": "rd-bot-autopilot/v1" },
            "mode": { "enum": ["dry-run", "live-test"] },
            "projectId": { "pattern": "^[0-9]{1,64}$" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "v2": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["provisioning"],
          "properties": {
            "schemaVersion": { "const": "rd-bot-autopilot/v2" },
            "mode": { "enum": ["dry-run", "live-provision"] },
            "provisioning": {
              "type": "object",
              "additionalProperties": false,
              "required": ["plan", "planSha256", "confirmation", "intents", "resources"],
              "properties": {
                "plan": { "type": ["object", "null"] },
                "planSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$|^$" },
                "confirmation": { "type": ["object", "null"] },
                "intents": { "type": "object", "maxProperties": 4 },
                "resources": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["github", "knowledgeBase", "sources", "project"],
                  "properties": {
                    "github": { "type": ["object", "null"] },
                    "knowledgeBase": { "type": ["object", "null"] },
                    "sources": { "type": "array", "maxItems": 2, "items": { "type": "object" } },
                    "project": { "type": ["object", "null"] }
                  }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}

